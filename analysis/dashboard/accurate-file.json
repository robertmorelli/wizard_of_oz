{"text": "<meta name=\"dash-one-writer\">\n<style>\n  .wz { display: flex; flex-direction: column; gap: var(--cds-gap-lg); font-family: var(--font-anthropic-sans); }\n  .wz h1 { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: var(--cds-font-size-title); margin: 0; text-wrap: balance; }\n  .wz h2 { font-size: var(--cds-font-size-heading); font-weight: var(--cds-font-weight-medium); margin: 0; }\n  .wz-lede { margin: 0; color: var(--color-fg); max-width: 70ch; }\n  .wz-lede b { font-family: var(--font-anthropic-serif); font-weight: 400; font-size: 1.25em; font-variant-numeric: tabular-nums; }\n  .wz-note { margin: 0; color: var(--color-fg-muted); font-size: var(--cds-font-size-caption); max-width: 75ch; }\n  .wz-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr)); gap: var(--cds-gap-md); }\n  .wz-card { background: var(--color-panel); border: 1px solid var(--color-border-line); border-radius: var(--cds-radius); padding: var(--cds-pad-lg); display: flex; flex-direction: column; gap: var(--cds-gap-sm); min-width: 0; }\n  .wz-legend { display: flex; gap: var(--cds-gap-md); flex-wrap: wrap; font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); align-items: center; }\n  .wz-legend span { display: inline-flex; align-items: center; gap: var(--cds-gap-xs); }\n  .wz-sw { width: 0.625rem; height: 0.625rem; border-radius: 50%; display: inline-block; background: var(--cds-chart-muted); }\n  .wz-sw.wz-hollow { background: transparent; border: 2px solid var(--color-fg-muted); box-sizing: border-box; }\n  .wz-sw.wz-zone { border-radius: 2px; background: var(--color-ok); opacity: .25; }\n  .wz-forest { position: relative; min-height: 12rem; }\n  .wz-forest svg { display: block; }\n  .wz-tip { position: absolute; pointer-events: none; background: var(--cds-surface-popover); border: 1px solid var(--cds-border); border-radius: var(--cds-radius); box-shadow: var(--cds-shadow-popover); padding: var(--cds-pad-xs) var(--cds-pad-sm); font-size: var(--cds-font-size-caption); white-space: nowrap; font-variant-numeric: tabular-nums; z-index: 2; }\n  .wz-tip .wz-tip-h { color: var(--cds-text-secondary); margin-bottom: 2px; }\n  .wz-tip .wz-tip-r { display: flex; gap: var(--cds-gap-xs); align-items: center; }\n  .wz-scroll { overflow-x: auto; }\n  .wz table { border-collapse: collapse; width: 100%; font-size: var(--cds-font-size-caption); font-variant-numeric: tabular-nums; }\n  .wz th { text-align: left; font-weight: var(--cds-font-weight-medium); color: var(--color-fg-muted); padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .wz td { padding: var(--cds-pad-xs) var(--cds-pad-sm); border-bottom: 1px solid var(--color-border-line); white-space: nowrap; }\n  .wz .wz-num { text-align: right; }\n  .wz-ok { color: var(--color-ok); }\n  .wz-bad { color: var(--color-bad); }\n  .wz details { font-size: var(--cds-font-size-caption); color: var(--color-fg-muted); }\n  .wz details dl { display: grid; grid-template-columns: max-content 1fr; gap: var(--cds-gap-xs) var(--cds-gap-md); max-width: 80ch; }\n  .wz details dt { color: var(--color-fg); }\n  .wz details dd { margin: 0; }\n  [data-dash-source-state=refreshing] { opacity: .5; transition: opacity var(--cds-dur-slow); }\n</style>\n\n<div class=\"wz\">\n  <header style=\"display:flex;flex-direction:column;gap:var(--cds-gap-sm)\">\n    <h1 id=\"top\">O3 vs Os vs Oz</h1>\n    <p class=\"wz-lede\">Os/Oz beat O3 in <b data-draw=\"s-wins\" data-source=\"summary\" data-field=\"wins\">\u2014</b> of <b data-draw=\"s-total\" data-source=\"summary\" data-field=\"total\">\u2014</b> comparisons. <b data-draw=\"s-both\" data-source=\"summary\" data-field=\"both\">\u2014</b> of those wins hold on both machines.</p>\n    <p class=\"wz-note\">Each number is small \u00f7 O3 time, the median over interleaved O3/small pairs. Below 1 means small is faster. A win or loss counts only when its 95% bootstrap interval stays on one side of 1. Mac is Apple silicon (arm64). x86 is a Ryzen 5 5600X under WSL2, pinned to one core.</p>\n  </header>\n\n  <div class=\"wz-grid\">\n    <section class=\"wz-card\" id=\"tally-card\">\n      <h2>Wins, ties and losses</h2>\n      <p class=\"wz-note\">Counted per comparison: program \u00d7 language \u00d7 level \u00d7 machine.</p>\n      <div class=\"wz-scroll\">\n        <table data-source=\"tally\" data-row-key=\"suite,machine\">\n          <thead><tr><th data-field=\"suite\">Suite</th><th data-field=\"machine\">Machine</th><th class=\"wz-num\" data-field=\"win\">Small wins</th><th class=\"wz-num\" data-field=\"tie\">Ties</th><th class=\"wz-num\" data-field=\"loss\">O3 wins</th></tr></thead>\n          <tbody data-draw=\"tally\"></tbody>\n        </table>\n      </div>\n    </section>\n\n    <section class=\"wz-card\" id=\"wins-card\">\n      <h2>Every small win</h2>\n      <p class=\"wz-note\">Sorted by size of the win. JPL rows name the compiler and the job it ran on t3.jpl.</p>\n      <div class=\"wz-scroll\">\n        <table data-source=\"wins\" data-row-key=\"id\">\n          <thead><tr><th data-field=\"suite\">Suite</th><th data-field=\"program\">Program</th><th data-field=\"lang\">Language / job</th><th data-field=\"level\">Level</th><th data-field=\"machine\">Machine</th><th class=\"wz-num\" data-field=\"ratio\">Small \u00f7 O3</th><th data-field=\"ci\">95% interval</th></tr></thead>\n          <tbody data-draw=\"wins\"></tbody>\n        </table>\n      </div>\n    </section>\n  </div>\n\n  <div class=\"wz-legend\" aria-label=\"Legend\">\n    <span><i class=\"wz-sw\" data-series=\"0\"></i>Mac</span>\n    <span><i class=\"wz-sw\" data-series=\"1\"></i>x86</span>\n    <span><i class=\"wz-sw wz-hollow\"></i>Hollow: tie</span>\n    <span><i class=\"wz-sw wz-zone\"></i>Shaded: small faster</span>\n    <span>Lines: 95% interval. Log scale.</span>\n  </div>\n\n  <section class=\"wz-card\" id=\"native\">\n    <h2>Benchmarks Game, native</h2>\n    <p class=\"wz-note\">Each process's time is the median of 5 timed runs after 2 warmup runs.</p>\n    <div class=\"wz-forest\" data-draw=\"forest\" data-suite=\"Native\" data-source=\"results\"></div>\n  </section>\n\n  <div class=\"wz-grid\">\n    <section class=\"wz-card\" id=\"jpl-cold\">\n      <h2>JPL compilers, cold</h2>\n      <p class=\"wz-note\">Page cache dropped before every run. On x86 the tooltip also shows CPU time, which the WSL memory slowdown doesn't affect.</p>\n      <div class=\"wz-forest\" data-draw=\"forest\" data-suite=\"JPL cold\" data-source=\"results\"></div>\n    </section>\n    <section class=\"wz-card\" id=\"jpl-warm\">\n      <h2>JPL compilers, warm</h2>\n      <p class=\"wz-note\">One untimed warmup run of each build first.</p>\n      <div class=\"wz-forest\" data-draw=\"forest\" data-suite=\"JPL warm\" data-source=\"results\"></div>\n    </section>\n  </div>\n\n  <details>\n    <summary>How this was measured</summary>\n    <dl>\n      <dt>Levels</dt><dd>O3 = speed build. Os/Oz = size builds. Rust opt-level 3/s/z, Swift -O/-Osize, Zig ReleaseFast/ReleaseSmall (no Os).</dd>\n      <dt>Pairs</dt><dd>O3 and the small build run back to back, alternating which goes first. The ratio is taken within each pair, then the median across pairs.</dd>\n      <dt>Interval</dt><dd>Bootstrap of the median paired ratio, resampling pairs.</dd>\n      <dt>JPL timing</dt><dd>Direct fork/exec/wait4 timer, no hyperfine. Cold drops the page cache first: purge on Mac, drop_caches on x86.</dd>\n      <dt>Native timing</dt><dd>Each benchmark's built-in driver: setup untimed, warmups, then the median of the timed runs.</dd>\n    </dl>\n  </details>\n</div>\n\n<script>\n  dash.calc('tally', {\n    title: 'Wins, ties, losses',\n    description: 'Count of each verdict per suite and machine.',\n    inputs: ['results'],\n    fn: (results) => d3.flatRollup(results, (v) => ({\n      win: v.filter((r) => r.verdict === 'win').length,\n      tie: v.filter((r) => r.verdict === 'tie').length,\n      loss: v.filter((r) => r.verdict === 'loss').length,\n    }), (r) => r.suite, (r) => r.machine).map(([suite, machine, c]) => ({suite, machine, ...c})),\n  });\n  dash.calc('wins', {\n    title: 'Small wins',\n    description: 'Comparisons whose whole 95% interval is below 1, smallest ratio first.',\n    inputs: ['results'],\n    fn: (results) => results.filter((r) => r.verdict === 'win').sort((a, b) => a.ratio - b.ratio)\n      .map((r) => ({id: r.id, suite: r.suite, program: r.program, lang: r.lang, level: r.level, machine: r.machine, ratio: r.ratio, ci: `${r.lo.toFixed(3)}\u2013${r.hi.toFixed(3)}`})),\n  });\n  dash.calc('summary', {\n    title: 'Win summary',\n    description: 'Total small wins, total comparisons, and wins that hold on both machines.',\n    inputs: ['results'],\n    fn: (results) => {\n      const key = (r) => `${r.suite}|${r.program}|${r.lang}|${r.level}`;\n      const won = d3.rollup(results.filter((r) => r.verdict === 'win'), (v) => new Set(v.map((r) => r.machine)).size, key);\n      return [{wins: results.filter((r) => r.verdict === 'win').length, total: results.length, both: [...won.values()].filter((n) => n === 2).length}];\n    },\n  });\n\n  dash.onData(() => {\n    document.querySelectorAll('.wz-sw[data-series]').forEach((s) => { s.style.background = dash.colors[+s.dataset.series]; });\n  });\n\n  for (const f of ['wins', 'total', 'both']) {\n    dash.draw('s-' + f, (el) => {\n      const g = dash.data('summary');\n      el.textContent = g.status === 'ok' && g.data[0] ? d3.format(',')(g.data[0][f]) : '\u2014';\n    });\n  }\n\n  dash.draw('tally', (tb) => {\n    const g = dash.data('tally');\n    tb.replaceChildren();\n    if (g.status !== 'ok') return;\n    for (const r of g.data) {\n      const tr = tb.insertRow();\n      const c = (t, cls) => { const td = tr.insertCell(); td.textContent = t; if (cls) td.className = cls; };\n      c(r.suite); c(r.machine);\n      c(r.win, 'wz-num' + (r.win ? ' wz-ok' : '')); c(r.tie, 'wz-num'); c(r.loss, 'wz-num');\n    }\n  });\n\n  dash.draw('wins', (tb) => {\n    const g = dash.data('wins');\n    tb.replaceChildren();\n    if (g.status !== 'ok') return;\n    for (const r of g.data) {\n      const tr = tb.insertRow();\n      tr.dataset.key = r.id;\n      for (const k of ['suite', 'program', 'lang', 'level', 'machine']) tr.insertCell().textContent = r[k];\n      const td = tr.insertCell(); td.textContent = r.ratio.toFixed(3); td.className = 'wz-num wz-ok';\n      tr.insertCell().textContent = r.ci;\n    }\n  });\n\n  const ORDER = {C: 0, 'C++': 1, Rust: 2, Swift: 3, lex: 0, parse: 1, typecheck: 2, Os: 0, Oz: 1};\n  const MACH = ['Mac', 'x86'];\n\n  dash.draw('forest', (el) => {\n    const g = dash.data('results');\n    el.replaceChildren();\n    if (g.status !== 'ok') { el.textContent = '\u2014'; return; }\n    const rows = g.data.filter((r) => r.suite === el.dataset.suite);\n    const groups = d3.groups(rows, (r) => `${r.program}|${r.lang}|${r.level}`)\n      .map(([k, v]) => ({program: v[0].program, lang: v[0].lang, level: v[0].level, by: Object.fromEntries(v.map((r) => [r.machine, r]))}))\n      .sort((a, b) => d3.ascending(a.program, b.program) || ORDER[a.lang] - ORDER[b.lang] || ORDER[a.level] - ORDER[b.level]);\n\n    const W = Math.max(320, el.clientWidth || 800), rowH = 22, top = 34, bottom = 8;\n    const H = top + groups.length * rowH + bottom;\n    const svg = d3.select(el).append('svg').attr('width', '100%').attr('viewBox', `0 0 ${W} ${H}`)\n      .style('font-size', 'var(--cds-font-size-caption)').style('font-family', 'var(--font-anthropic-sans)');\n\n    // labels first, so the left margin fits the widest one\n    const lab = svg.append('g');\n    const progT = [], varT = [];\n    groups.forEach((d, i) => {\n      const first = i === 0 || groups[i - 1].program !== d.program;\n      if (first) progT.push(lab.append('text').attr('y', top + i * rowH + rowH / 2).attr('dy', '0.35em').attr('fill', 'var(--color-fg)').attr('font-weight', 500).text(d.program));\n      varT.push(lab.append('text').attr('y', top + i * rowH + rowH / 2).attr('dy', '0.35em').attr('fill', 'var(--color-fg-muted)').text(`${d.lang} ${d.level}`));\n    });\n    const pw = d3.max(progT, (t) => t.node().getComputedTextLength()) || 0;\n    const vw = d3.max(varT, (t) => t.node().getComputedTextLength()) || 0;\n    progT.forEach((t) => t.attr('x', 0));\n    varT.forEach((t) => t.attr('x', pw + 10));\n    const left = pw + vw + 22, right = 14;\n\n    const lo = Math.min(0.9, d3.min(rows, (r) => r.lo)) * 0.97, hi = Math.max(1.1, d3.max(rows, (r) => r.hi)) * 1.03;\n    const x = d3.scaleLog([lo, hi], [left, W - right]);\n    const cand = [0.6, 0.7, 0.8, 0.9, 1, 1.1, 1.25, 1.5, 2, 3, 4, 5];\n    let ticks = cand.filter((t) => t >= lo && t <= hi);\n    // drop ticks that would collide\n    const kept = [];\n    for (const t of ticks) if (!kept.length || x(t) - x(kept[kept.length - 1]) >= 34 || t === 1) { if (t === 1 && kept.length && x(1) - x(kept[kept.length - 1]) < 34) kept.pop(); kept.push(t); }\n    ticks = kept;\n\n    const plot = svg.insert('g', ':first-child');\n    plot.append('rect').attr('x', x(lo)).attr('y', top - 4).attr('width', x(1) - x(lo)).attr('height', H - top - bottom + 4)\n      .attr('fill', 'var(--color-ok)').attr('opacity', 0.08);\n    // group separators\n    groups.forEach((d, i) => {\n      if (i > 0 && groups[i - 1].program !== d.program)\n        plot.append('line').attr('x1', 0).attr('x2', W - right).attr('y1', top + i * rowH).attr('y2', top + i * rowH).attr('stroke', 'var(--cds-chart-grid)');\n    });\n    for (const t of ticks) {\n      plot.append('line').attr('x1', x(t)).attr('x2', x(t)).attr('y1', top - 4).attr('y2', H - bottom)\n        .attr('stroke', t === 1 ? 'var(--cds-chart-reference)' : 'var(--cds-chart-grid)').attr('stroke-width', t === 1 ? 1.5 : 1);\n      plot.append('text').attr('x', x(t)).attr('y', top - 10).attr('text-anchor', 'middle').attr('fill', 'var(--color-fg-muted)').text(d3.format('~g')(t));\n    }\n    plot.append('text').attr('x', x(1) - 6).attr('y', 10).attr('text-anchor', 'end').attr('fill', 'var(--color-ok)').text('\u2190 small faster');\n    plot.append('text').attr('x', x(1) + 6).attr('y', 10).attr('fill', 'var(--color-fg-muted)').text('O3 faster \u2192');\n\n    const marks = svg.append('g');\n    groups.forEach((d, i) => {\n      MACH.forEach((m, j) => {\n        const r = d.by[m]; if (!r) return;\n        const y = top + i * rowH + rowH / 2 + (j ? 4 : -4), col = dash.colors[j];\n        marks.append('line').attr('x1', x(r.lo)).attr('x2', x(r.hi)).attr('y1', y).attr('y2', y).attr('stroke', col).attr('stroke-width', 2).attr('stroke-linecap', 'round');\n        marks.append('circle').attr('cx', x(r.ratio)).attr('cy', y).attr('r', r.verdict === 'win' ? 4.5 : 3.5)\n          .attr('fill', r.verdict === 'tie' ? 'var(--color-panel)' : col).attr('stroke', r.verdict === 'tie' ? col : 'var(--color-panel)').attr('stroke-width', r.verdict === 'tie' ? 1.5 : 1);\n      });\n    });\n\n    const tip = document.createElement('div');\n    tip.className = 'wz-tip'; tip.hidden = true; el.appendChild(tip);\n    const hl = svg.append('rect').attr('x', 0).attr('width', W).attr('height', rowH).attr('fill', 'var(--color-fg)').attr('opacity', 0).attr('pointer-events', 'none');\n    const f3 = d3.format('.3f');\n    svg.append('g').selectAll('rect').data(groups).join('rect')\n      .attr('x', 0).attr('width', W).attr('y', (d, i) => top + i * rowH).attr('height', rowH).attr('fill', 'transparent')\n      .on('pointermove', (ev, d) => {\n        const i = groups.indexOf(d);\n        hl.attr('y', top + i * rowH).attr('opacity', 0.05);\n        tip.replaceChildren();\n        const h = document.createElement('div'); h.className = 'wz-tip-h'; h.textContent = `${d.program} \u00b7 ${d.lang} ${d.level} \u00f7 O3`; tip.appendChild(h);\n        MACH.forEach((m, j) => {\n          const r = d.by[m]; if (!r) return;\n          const line = document.createElement('div'); line.className = 'wz-tip-r';\n          const sw = document.createElement('i'); sw.className = 'wz-sw'; sw.style.background = dash.colors[j];\n          const tx = document.createElement('span');\n          tx.textContent = `${m} ${f3(r.ratio)} [${f3(r.lo)}\u2013${f3(r.hi)}] ${r.verdict === 'win' ? 'small wins' : r.verdict === 'loss' ? 'O3 wins' : 'tie'}${r.cpu != null && m === 'x86' ? ` \u00b7 CPU ${f3(r.cpu)}` : ''} \u00b7 ${r.pairs} pairs`;\n          line.append(sw, tx); tip.appendChild(line);\n        });\n        tip.hidden = false;\n        const [px, py] = d3.pointer(ev, el);\n        const tw = tip.offsetWidth, th = tip.offsetHeight, ew = el.clientWidth;\n        let tx = px + 14; if (tx + tw > ew) tx = px - tw - 14; if (tx < 0) tx = Math.max(0, ew - tw);\n        tip.style.left = tx + 'px';\n        tip.style.top = Math.max(0, Math.min(py - th / 2, el.clientHeight - th)) + 'px';\n      })\n      .on('pointerleave', () => { tip.hidden = true; hl.attr('opacity', 0); });\n    el.style.minHeight = H + 'px';\n  });\n</script>\n", "edit": {"via": "claude", "at": "2026-11-08T15:14:13Z"}}